<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layoutSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Topo: nome do usuario + status -->
            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nomeHint"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtStatusMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/monitorando"
                android:textColor="@color/verdeMonitorando"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Secao: sensores -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tituloSensores"
                android:textColor="@color/textoSecao"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoAcelerometro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloAceleracao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloAcelerometro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAceleracao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoGiroscopio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloGiroscopio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloGiroscopio"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtGiroscopio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoProximidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloProximidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloProximidade"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProximidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoLuminosidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloLuminosidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloLuminosidade"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLuminosidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoPressao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloPressao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloPressao"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPressao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/txtTemperatura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secao: localizacao e bateria -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tituloLocalizacaoBateria"
                android:textColor="@color/textoSecao"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloLocalizacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloLocalizacao"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLatitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtLongitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtVelocidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloDispositivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloDispositivo"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBateria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtModelo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valorInicial"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secao: status da API -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tituloStatusApi"
                android:textColor="@color/textoSecao"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cartaoQueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloQueda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tituloQueda"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtQueda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/semQueda"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txtStatusApi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/statusInicial"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secao: seguranca e clima -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tituloSeguranca"
                android:textColor="@color/textoSecao"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnContatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btnContatos"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btnHistorico"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swCheckin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/checkinSwitch"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtClima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/climaInicial"
                android:textSize="16sp" />

            <!-- Botao de simular queda, menor -->
            <Button
                android:id="@+id/btnSimularQueda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:text="@string/btnSimularQueda"
                android:textSize="14sp" />

            <!-- Botao de panico grande no rodape -->
            <Button
                android:id="@+id/btnPanico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/vermelhoPanico"
                android:minHeight="64dp"
                android:text="@string/btnPanico"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Overlay de alerta de queda -->
    <LinearLayout
        android:id="@+id/painelQueda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundoAlerta"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quedaDetectadaTitulo"
            android:textColor="@color/vermelhoStatus"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enviandoAlerta"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtContagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contagemInicial"
            android:textColor="@color/white"
            android:textSize="72sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEstouBem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/estouBemCancelar"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
