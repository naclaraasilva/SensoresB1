<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deepForest"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/margemTela">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/historicoTitulo"
        android:textColor="@color/sandCream"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtHistoricoVazio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/cinzaTeal"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listaEventos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />
</LinearLayout>
