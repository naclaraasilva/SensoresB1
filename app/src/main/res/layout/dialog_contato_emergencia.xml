<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surfaceEscuro"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- cabecalho com icone e titulo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fundo_circulo_lime">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/contatosTitulo"
                android:src="@drawable/ic_pessoa"
                app:tint="@color/limeAccent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contatosTitulo"
                android:textColor="@color/sandCream"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contatosCardSub"
                android:textColor="@color/limeAccent"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- caixa de ajuda explicando o uso do contato -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/fundo_caixa_escura"
        android:padding="12dp"
        android:text="@string/contatoAjuda"
        android:textColor="@color/sandCream70"
        android:textSize="12sp" />

    <!-- campo do nome do contato -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/contatoNomeLabel"
        android:textColor="@color/cinzaTeal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/fundo_campo"
        android:hint="@string/contatoNomeHint"
        android:imeOptions="actionNext"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/sandCream"
        android:textColorHint="@color/cinzaTeal"
        android:textSize="16sp" />

    <!-- campo do unico telefone -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/contatoTelefoneLabel"
        android:textColor="@color/cinzaTeal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/fundo_campo"
        android:hint="@string/contatoTelefoneHint"
        android:imeOptions="actionDone"
        android:inputType="phone"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/sandCream"
        android:textColorHint="@color/cinzaTeal"
        android:textSize="16sp" />
</LinearLayout>
